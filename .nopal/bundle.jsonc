{
  // Nopal's repository-local v0.3 bundle keeps executable extension code to
  // the byte-verified enforcement adapter. Skills remain ambient prose and
  // lifecycle resources; other extensions must wait for an enforcement-aware
  // profile instead of bypassing the tool-call assurance boundary.
  "version": "nopal.bundle/v1",
  "inherit_ambient": ["skills"],
  "extensions": [
    { "source": "policy-gate", "path": "extensions/policy-gate/index.ts" }
  ],
  "themes": [
    { "source": "nopal-dark", "path": ".nopal/theme.json" }
  ]
}
