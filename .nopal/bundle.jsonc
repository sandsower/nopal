{
  // Nopal's dogfood contract permits ambient prose skills, but executable
  // extension authority remains confined to the byte-verified Nopal adapter.
  "version": "nopal.bundle/v2",
  "inherit_ambient": ["skills"],
  "packages": [
    {
      "id": "nopal",
      "source": { "type": "builtin", "package": "nopal" },
      "requirement": "=0.2.16",
      "resources": [
        { "kind": "extension", "path": "index.ts" }
      ]
    }
  ]
}
