{
  // Every Pi resource comes from this byte-locked distribution.
  // Ambient packages and resources are not part of Nopal's guarantee.
  "version": "nopal.bundle/v2",
  "packages": [
    {
      "id": "nopal",
      "source": { "type": "builtin", "package": "nopal" },
      "requirement": "=0.2.21",
      "resources": [
        { "kind": "extension", "path": "extensions/policy-gate/index.ts" },
        { "kind": "skill", "path": "resources/beislid/skills" }
      ]
    }
  ]
}
