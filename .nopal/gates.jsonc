{
  "gates": [
    {
      "autofix": "cargo fmt --all",
      "argv": ["cargo", "fmt", "--all", "--check"],
      "id": "fmt",
      "stage": "pre_pr"
    },
    {
      "argv": ["cargo", "clippy", "--workspace", "--all-targets", "--", "-D", "warnings"],
      "id": "clippy",
      "stage": "pre_pr"
    },
    {
      "argv": ["cargo", "test", "--workspace"],
      "id": "test",
      "stage": "pre_pr"
    },
    {
      "argv": ["npm", "test"],
      "id": "ext-test",
      "stage": "pre_pr"
    },
    {
      "argv": ["scripts/check-public-tree.sh"],
      "id": "public-tree",
      "stage": "pre_pr"
    }
  ],
  "version": "nopal.gates/v1"
}
