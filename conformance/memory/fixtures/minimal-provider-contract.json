{
  "kind": "nopal.memory_provider.contract/v1",
  "surface": "nopal.memory_provider/v1",
  "status": "v1",
  "transport": {
    "style": "json_subprocess",
    "invocation": "python3 -m memento.pi_bridge <operation> [args] -> one JSON object on stdout"
  },
  "operations": [
    {
      "operation": "provider.status",
      "reference_command": "status",
      "request_concepts": [],
      "response_concepts": ["vault_path", "vault_exists", "note_count", "queued_capture_count", "queue_path", "pi_bridge_health.status"],
      "degraded_shapes": ["queued_capture_count = {\"skipped\": \"lock_unavailable\"}"]
    },
    {
      "operation": "context.briefing",
      "reference_command": "briefing",
      "request_concepts": ["session identity"],
      "response_concepts": ["should_inject", "content", "source", "results"]
    },
    {
      "operation": "context.recall",
      "reference_command": "recall",
      "request_concepts": ["prompt text"],
      "response_concepts": ["should_inject", "content", "source", "results"]
    },
    {
      "operation": "context.session",
      "reference_command": "session-context",
      "request_concepts": ["session identity"],
      "response_concepts": ["should_inject", "content", "source", "results", "metadata.sections.queue"]
    },
    {
      "operation": "context.tool",
      "reference_command": "tool-context",
      "request_concepts": ["tool call summary"],
      "response_concepts": ["should_inject", "content", "source", "results"]
    },
    {
      "operation": "memory.search",
      "reference_command": "search --query",
      "request_concepts": ["query string"],
      "response_concepts": ["results[].path", "results[].title", "results[].score", "results[].backend"],
      "degraded_shapes": ["miss envelope: results=[] + miss.reason + miss.recovery_hints"]
    },
    {
      "operation": "memory.get",
      "reference_command": "get",
      "request_concepts": ["durable note path"],
      "response_concepts": ["path", "title", "content"]
    },
    {
      "operation": "memory.capture",
      "reference_command": "capture [--queue]",
      "request_concepts": ["title", "body", "provenance"],
      "response_concepts": ["path | id", "queued"],
      "degraded_shapes": ["dead_lettered=true + reason=queue_lock_unavailable"]
    },
    {
      "operation": "memory.run_lesson",
      "reference_command": "run-lesson --payload <json-file>",
      "request_concepts": ["run_id", "ticket_id"],
      "response_concepts": ["created", "path", "queued=false"]
    },
    {
      "operation": "queue.list",
      "reference_command": "queue list",
      "request_concepts": [],
      "response_concepts": ["count", "captures", "queue_path"],
      "degraded_shapes": ["{\"skipped\": \"lock_unavailable\"}"]
    }
  ],
  "guarantees": {
    "capture_then_recall": "run-lesson with run_id+ticket_id writes a curated note findable by either identifier via memory.search immediately, grep backend sufficient",
    "fail_closed_lock": "QueueLockUnavailable degrades reads to skipped shapes and routes enqueue to dead-letter after bounded retries; never silent unlocked access",
    "miss_envelope": "search misses return results=[] plus miss.reason (open vocabulary) and miss.recovery_hints",
    "in_band_errors": "errors are {error, reason} JSON with stable reason codes; unknown codes handled conservatively"
  },
  "reason_codes": [
    "missing_payload",
    "payload_read_error",
    "payload_invalid_json",
    "payload_invalid_shape",
    "missing_required_field",
    "invalid_automated_run_lesson",
    "vault_missing",
    "lock_timeout",
    "queue_lock_unavailable"
  ],
  "provider": {
    "name": "memento-vault",
    "min_version": "5.0.0"
  }
}
