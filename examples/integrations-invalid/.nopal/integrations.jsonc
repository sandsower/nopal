{
  "version": "nopal.integrations/v1",
  "tracker": {
    "ticket_source": {
      "type": "file",
      "id_pattern": "(",
      "file_glob": "["
    }
  },
  "visual_surfaces": { "provider": "surprise-browser", "mode": "prompt" },
  "workflow_signals": { "mode": "auto", "sinks": [ { "type": "webhook" } ] },
  "pi_handoff": {
    "events": ["made_up_event"],
    "exclude": ["future_event"]
  }
}
