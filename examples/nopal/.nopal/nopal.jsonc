{
  // The nopal profile requires the deterministic project modules used by
  // the enforced Pi distribution.
  "version": "nopal.project/v1",
  "project": { "name": "nopal-example" },
  "profile": "nopal",
  "profiles": {
    "nopal": {
      "required_modules": ["gates", "policy", "workflow", "roots", "guidance"]
    }
  }
}
