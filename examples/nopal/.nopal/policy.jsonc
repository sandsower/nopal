{
  // nopal.policy/v1: action decisions and runtime isolation placement.
  // supervised_auto is interactive; unattended_auto is headless execution.
  "version": "nopal.policy/v1",
  "modes": {
    "supervised_auto": {
      "default_decision": "ask",
      "default_placement": "shared_user_runtime",
      "rules": [
        {
          "id": "allow-inspection",
          "classes": ["read", "network_read"],
          "decision": "allow"
        },
        {
          "id": "deny-destructive",
          "classes": ["destructive"],
          "decision": "deny",
          "reason": "destructive work remains denied"
        }
      ]
    },
    "unattended_auto": {
      "default_decision": "ask",
      "default_placement": "dedicated_repo_runtime",
      "rules": [
        {
          "id": "allow-afk-basics",
          "classes": ["read", "workspace_write", "git_local"],
          "decision": "allow"
        },
        {
          "id": "allow-remote-delivery",
          "actions": ["git.push", "gh.pr.create"],
          "decision": "allow",
          "reason": "AFK runs deliver branches and PRs"
        },
        {
          "id": "isolate-secrets",
          "classes": ["secret_bearing"],
          "placement": "dedicated_run_runtime",
          "reason": "secret-bearing actions get a dedicated run runtime"
        },
        {
          "id": "deny-destructive",
          "classes": ["destructive"],
          "decision": "deny"
        }
      ]
    }
  },
  "env": [
    { "name": "LINEAR_API_KEY", "classes": ["secret_bearing"] },
    { "name": "HOME", "classes": [] }
  ]
}
