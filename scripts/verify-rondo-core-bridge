#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
nopal_root="$(cd "${script_dir}/.." && pwd)"
rondo_root="${1:-${RONDO_ROOT:-}}"

if [[ -z "${rondo_root}" ]]; then
  echo "usage: scripts/verify-rondo-core-bridge <rondo-repository-root>" >&2
  exit 2
fi

rondo_root="$(cd "${rondo_root}" && pwd)"
rondo_elixir="${rondo_root}/elixir"
conformance_test="${nopal_root}/tests/conformance/rondo_core_bridge_test.exs"
lifecycle_test="${nopal_root}/tests/conformance/rondo_core_lifecycle_test.exs"
build_root="$(mktemp -d "${TMPDIR:-/tmp}/nopal-rondo-core-bridge.XXXXXX")"
trap 'rm -rf "${build_root}"' EXIT
nopal_target_dir="${build_root}/target"
nopal_bin="${nopal_target_dir}/debug/nopal"
service_schema="${nopal_root}/conformance/execution/schemas/rondo-core-service-v1.schema.json"
service_fixture="${nopal_root}/conformance/execution/fixtures/minimal-service-contract.json"
nopal_schema="${nopal_root}/conformance/execution/schemas/rondo-core-run-events-v1.schema.json"
rondo_schema="${rondo_root}/docs/proposed-teotl-conformance/execution/schemas/rondo-core-run-events-v1.schema.json"
schema_validator="${nopal_root}/tests/conformance/validate-rondo-core-run-events.mjs"
archived_fixture="${nopal_root}/conformance/execution/fixtures/run-events-archived-replay.json"
resume_fixture="${nopal_root}/conformance/execution/fixtures/run-events-resume.json"

if [[ ! -f "${rondo_elixir}/mix.exs" ]]; then
  echo "rondo repository does not contain elixir/mix.exs" >&2
  exit 2
fi

if [[ ! -f "${rondo_schema}" ]]; then
  echo "rondo repository does not contain the proposed Core run-events schema" >&2
  exit 2
fi

if ! cmp -s "${nopal_schema}" "${rondo_schema}"; then
  echo "Core run-events schema drift: Nopal and Rondo copies differ" >&2
  diff -u \
    --label "Nopal canonical run-events schema" \
    --label "Rondo proposed run-events schema" \
    "${nopal_schema}" "${rondo_schema}" >&2 || true
  exit 1
fi

node "${schema_validator}" documents "${service_schema}" "${service_fixture}"
node "${schema_validator}" fixtures "${nopal_schema}" "${archived_fixture}" "${resume_fixture}"

CARGO_TARGET_DIR="${nopal_target_dir}" cargo build --locked --manifest-path "${nopal_root}/Cargo.toml" -p nopal-cli

if [[ ! -x "${nopal_bin}" ]]; then
  echo "isolated Nopal build did not produce the expected executable" >&2
  exit 1
fi

unset NOPAL_RONDO_CORE_URL

(
  cd "${rondo_elixir}"
  mise exec -- mix escript.build
  NOPAL_BIN="${nopal_bin}" \
    NOPAL_ROOT="${nopal_root}" \
    RONDO_BIN="${rondo_elixir}/bin/rondo" \
    NOPAL_RUN_EVENTS_SCHEMA="${nopal_schema}" \
    NOPAL_SCHEMA_VALIDATOR="${schema_validator}" \
    mise exec -- mix test "${conformance_test}" "${lifecycle_test}" --trace --no-color
)
